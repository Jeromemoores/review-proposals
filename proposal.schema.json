{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "enum": [
              "bug",
              "refactor",
              "optimization"
            ]
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "benefit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "tradeoffs": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "documentation": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://",
                  "maxLength": 2048
                }
              },
              "required": [
                "title",
                "url"
              ]
            }
          },
          "checks": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "not-run"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                }
              },
              "required": [
                "description",
                "status"
              ]
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "before": {
                  "type": "string",
                  "maxLength": 1000000
                },
                "after": {
                  "type": "string",
                  "maxLength": 1000000
                },
                "baseSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "before",
                "after",
                "baseSha256"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "priority",
          "reason",
          "documentation",
          "checks",
          "files"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "groups"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jeromemoores/review-proposals/main/proposal.schema.json",
  "title": "Review Proposals v1",
  "description": "Existing UTF-8 text replacements. Importer additionally validates path containment, original-content hashes and total size."
}
