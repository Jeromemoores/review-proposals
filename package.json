{
  "name": "review-proposals",
  "displayName": "Review Proposals",
  "description": "Review agent-proposed changes in a diff before applying them.",
  "version": "0.2.0",
  "publisher": "Jeromemoores",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeromemoores/review-proposals.git"
  },
  "homepage": "https://github.com/Jeromemoores/review-proposals#readme",
  "bugs": {
    "url": "https://github.com/Jeromemoores/review-proposals/issues"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:reviewProposals.pending",
    "onView:reviewProposals.scm"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Preview is available; applying proposals and installing the companion skill require a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Version 0.1 requires a local or remote filesystem workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "reviewProposals.loadLatest",
        "title": "Show Latest Review",
        "category": "Review Proposals",
        "icon": "$(sync)"
      },
      {
        "command": "reviewProposals.showAccepted",
        "title": "Show/Hide Accepted Recommendations",
        "category": "Review Proposals",
        "icon": "$(history)"
      },
      {
        "command": "reviewProposals.import",
        "title": "Import Proposal",
        "category": "Review Proposals",
        "icon": "$(folder-opened)"
      },
      {
        "command": "reviewProposals.preview",
        "title": "Preview Change",
        "category": "Review Proposals"
      },
      {
        "command": "reviewProposals.details",
        "title": "Show Recommendation Details",
        "category": "Review Proposals",
        "icon": "$(info)"
      },
      {
        "command": "reviewProposals.accept",
        "title": "Accept Recommendation",
        "category": "Review Proposals",
        "icon": "$(check)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "reviewProposals.reject",
        "title": "Reject Recommendation",
        "category": "Review Proposals",
        "icon": "$(close)"
      },
      {
        "command": "reviewProposals.refresh",
        "title": "Refresh Status",
        "category": "Review Proposals",
        "icon": "$(refresh)"
      },
      {
        "command": "reviewProposals.clear",
        "title": "Clear Review",
        "category": "Review Proposals"
      },
      {
        "command": "reviewProposals.copyInstructions",
        "title": "Copy Agent Review Instructions",
        "category": "Review Proposals"
      },
      {
        "command": "reviewProposals.installSkill",
        "title": "Install Companion Skill for Claude Code and Codex",
        "category": "Review Proposals"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewProposals",
          "title": "Review Proposals",
          "icon": "assets/review.svg"
        }
      ]
    },
    "views": {
      "reviewProposals": [
        {
          "id": "reviewProposals.pending",
          "name": "Recommendations"
        }
      ],
      "scm": [
        {
          "id": "reviewProposals.scm",
          "name": "Proposed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reviewProposals.pending",
        "contents": "Completed agent reviews appear here automatically.\n[Show latest review](command:reviewProposals.loadLatest)\n[Copy agent review instructions](command:reviewProposals.copyInstructions)\n[Install companion skill](command:reviewProposals.installSkill)\n[Import an older proposal file](command:reviewProposals.import)",
        "when": "!reviewProposals.hasReview"
      },
      {
        "view": "reviewProposals.scm",
        "contents": "Completed agent reviews appear here automatically.\n[Show latest review](command:reviewProposals.loadLatest)\n[Copy agent review instructions](command:reviewProposals.copyInstructions)\n[Install companion skill](command:reviewProposals.installSkill)\n[Import an older proposal file](command:reviewProposals.import)",
        "when": "!reviewProposals.hasReview"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reviewProposals.loadLatest",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm)",
          "group": "navigation@1"
        },
        {
          "command": "reviewProposals.showAccepted",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm) && reviewProposals.hasReview"
        },
        {
          "command": "reviewProposals.import",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm)",
          "group": "tools"
        },
        {
          "command": "reviewProposals.refresh",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm)",
          "group": "navigation"
        },
        {
          "command": "reviewProposals.copyInstructions",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm)"
        },
        {
          "command": "reviewProposals.installSkill",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm)"
        },
        {
          "command": "reviewProposals.clear",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm) && reviewProposals.hasReview"
        }
      ],
      "view/item/context": [
        {
          "command": "reviewProposals.accept",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm) && viewItem == reviewGroup.pending && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "reviewProposals.reject",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm) && viewItem == reviewGroup.pending",
          "group": "inline@2"
        },
        {
          "command": "reviewProposals.reject",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm) && viewItem == reviewGroup.stale",
          "group": "inline@2"
        },
        {
          "command": "reviewProposals.details",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm) && viewItem =~ /^reviewGroup/",
          "group": "inline@3"
        },
        {
          "command": "reviewProposals.preview",
          "when": "(view == reviewProposals.pending || view == reviewProposals.scm) && viewItem == reviewFile"
        }
      ],
      "editor/title": [
        {
          "command": "reviewProposals.accept",
          "when": "resourceScheme == review-proposal && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "reviewProposals.reject",
          "when": "resourceScheme == review-proposal",
          "group": "navigation@2"
        },
        {
          "command": "reviewProposals.details",
          "when": "resourceScheme == review-proposal",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Review Proposals",
      "properties": {
        "reviewProposals.autoImport": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show completed agent reviews from the open workspace review inbox. Never applies code changes."
        },
        "reviewProposals.acceptedCleanupDelay": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 3600,
          "description": "Seconds before accepted recommendations disappear from the sidebar. Set 0 to keep them visible. Decisions are preserved; no source or proposal files are deleted."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:integration": "npm run compile && node tools/run-integration.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --skip-license --out dist/review-proposals-0.2.0.vsix"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "7.0.2"
  }
}
